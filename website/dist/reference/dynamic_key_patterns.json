  "graphicsAnimation": {
    "section": "graphics",
    "prefixes": [
      "animation_moving_",
      "animation_idle_",
      "animation_attack_"
    ],
    "suffixes": [
      "blendIn",
      "blendOut",
      "end",
      "KeyframeTimeScale",
      "onActions",
      "onActionsQueuedUnitPlayAt",
      "pingPong",
      "playbackRate",
      "scale_end",
      "scale_start",
      "speed",
      "start"
    ],
    "note_zh": "direction_* 在方向动画解析器中另以空前缀读取，不应自动加 animation_moving_。"
  },
  "preprocessor": {
    "patterns": [
      "@global NAME",
      "@define NAME",
      "@memory NAME",
      "@copyFromSection",
      "@copyFrom_skipThisSection"
    ],
    "note_zh": "@memory 只用于 core 的内存声明；其余按对应预处理语境使用。"
  },
  "localizedText": {
    "pattern": "BASE_LANGUAGE",
    "examples": [
      "displayText_zh",
      "displayDescription_zh",
      "text_zh"
    ],
    "note_zh": "仅扩展多语言文本读取器支持的基础字段。"
  },
  "projectileMutator": {
    "section": "projectile_NAME",
    "pattern": "mutatorNAME_SUFFIX",
    "example": "mutator1_ifUnitWithTags",
    "suffixes": [
      "addResourcesAreaHit",
      "addResourcesDirectHit",
      "areaDamageMultiplier",
      "changedExplodeEffect",
      "directDamageMultiplier",
      "ifUnitWithoutTags",
      "ifUnitWithTags"
    ]
  }
